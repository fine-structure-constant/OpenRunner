<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/icon" />

    <!--
        26dp 品牌色短横，分区标记。左端站 or_drawer_pad —— 与下方印章、菜单图标
        同一条内容列，不落在左侧那条装饰槽里：它是「这一块内容」的抬头，
        不是菜单选中标记那种与内容无关的状态记号。
    -->
    <View
        android:layout_width="26dp"
        android:layout_height="@dimen/or_rule_height_strong"
        android:layout_marginStart="@dimen/or_drawer_pad"
        android:layout_marginTop="@dimen/or_space_lg"
        android:background="@color/or_primary"
        android:importantForAccessibility="no" />

    <!--
        内容块走 or_drawer_pad 而不是 or_page_pad：印章（22dp）与菜单图标（24dp）
        是同一种领头的徽标，左缘对齐之后抽屉才只有一条内容列。or_page_pad 是
        页面级 token，管的是页面工具栏与正文的对齐，抽屉是浮层、不参与那个节奏。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/or_drawer_pad"
        android:paddingTop="@dimen/or_space_md"
        android:paddingEnd="@dimen/or_drawer_pad"
        android:paddingBottom="@dimen/or_space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <cn.edu.pku.openrunner.ui.SealView
                style="@style/Widget.OpenRunner.Seal"
                android:text="@string/or_seal_run" />

            <TextView
                android:id="@+id/drawer_welcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.OpenRunner.PageTitle"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/drawer_user_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/or_space_sm"
            android:textAppearance="@style/TextAppearance.OpenRunner.Caption" />

        <View
            style="@style/Widget.OpenRunner.Rule"
            android:layout_marginTop="@dimen/or_space_lg" />

        <TextView
            android:id="@+id/drawer_mileage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/or_space_md"
            android:textAppearance="@style/TextAppearance.OpenRunner.Metric.Small" />

        <TextView
            android:id="@+id/drawer_mileage_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/or_space_xs"
            android:textAppearance="@style/TextAppearance.OpenRunner.Caption" />

        <TextView
            android:id="@+id/drawer_sync_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/or_space_xs"
            android:textAppearance="@style/TextAppearance.OpenRunner.Caption" />
    </LinearLayout>
</LinearLayout>
