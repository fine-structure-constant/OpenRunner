<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        ============================================================
        品牌专属色角色
        ============================================================
        Material 3 的色槽（colorPrimary / colorSurface / ...）里没有"深色主视觉块"这一角色，
        但它在本设计系统里承担明确语义（天气主卡、账户名片），因此提升为自定义主题属性。

        为什么必须是主题属性而不是直接写 @color/or_hero：
        主题 overlay（如 Theme.OpenRunner.Hud）只能覆盖主题属性。
        若样式里写死色值，一旦该样式被 overlay 覆盖的子树引用，就会静默失效、
        在深色底上渲染出浅色块。写成 ?attr/ 则 overlay 只需补一行即可接管。
        ============================================================
    -->

    <!-- 深色主视觉块的底色 -->
    <attr name="orHeroSurface" format="color" />

    <!-- 深色主视觉块之上的文字与细线颜色 -->
    <attr name="orOnHeroSurface" format="color" />

</resources>
