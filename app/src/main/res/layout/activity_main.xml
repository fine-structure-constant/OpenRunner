<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/or_surface"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/main_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:title="@string/app_name" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/or_rule_height"
            android:background="@color/or_outline"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!--
        选中项的高亮不用 Material 的 itemShapeFillColor / itemShapeAppearanceOverlay /
        itemShapeInset*：那套只能给菜单项一个形状，而选中态要的是
        「胶囊底色 + 左缘竖装饰线」两层。整块背景改由 itemBackground 提供，
        见 drawable/or_nav_item_background.xml（含为什么必须自带 ripple）。
    -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/main_navigation"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/or_surface_container"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/main_drawer_header"
        app:itemBackground="@drawable/or_nav_item_background"
        app:itemHorizontalPadding="24dp"
        app:itemIconTint="@color/or_nav_item_content"
        app:itemTextAppearance="@style/TextAppearance.OpenRunner.Body"
        app:itemTextColor="@color/or_nav_item_content"
        app:menu="@menu/main_drawer_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
