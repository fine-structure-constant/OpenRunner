<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/hike_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="vertical"
        android:padding="@dimen/or_space_md">

        <LinearLayout
            android:id="@+id/hike_map_column"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/or_space_sm"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hike_basemap"
                    style="@style/Widget.OpenRunner.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/or_space_sm"
                    android:layout_weight="1"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="@dimen/or_space_sm"
                    android:text="@string/hike_basemap_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hike_files"
                    style="@style/Widget.OpenRunner.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="@dimen/or_space_sm"
                    android:text="@string/hike_files" />
            </LinearLayout>

            <!-- Both weighted containers have a zero size along their weighted axis. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hike_map_frame"
                style="@style/Widget.OpenRunner.Card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.OpenRunner.Card.Soft"
                tools:ignore="NestedWeights">

                <FrameLayout
                    android:id="@+id/hike_map_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <cn.edu.pku.openrunner.feature.hike.ui.HikeMapView
                        android:id="@+id/hike_map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/hike_map_description" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/or_space_sm"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hike_zoom_out"
                            style="@style/Widget.OpenRunner.Button.MapControl"
                            android:layout_marginEnd="@dimen/or_space_sm"
                            android:contentDescription="@string/hike_zoom_out"
                            app:icon="@drawable/ic_or_zoom_out" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hike_zoom_in"
                            style="@style/Widget.OpenRunner.Button.MapControl"
                            android:layout_marginEnd="@dimen/or_space_sm"
                            android:contentDescription="@string/hike_zoom_in"
                            app:icon="@drawable/ic_or_zoom_in" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hike_recenter"
                            style="@style/Widget.OpenRunner.Button.MapControl"
                            android:contentDescription="@string/hike_recenter"
                            app:icon="@drawable/ic_or_recenter" />
                    </LinearLayout>

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/hike_map_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/or_space_xs"
                android:textAppearance="@style/TextAppearance.OpenRunner.Caption"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hike_recording_panel"
            style="@style/Widget.OpenRunner.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/or_space_sm"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.OpenRunner.Card.Soft">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/or_space_md">

                <cn.edu.pku.openrunner.feature.hike.ui.HikeDetailsScrollView
                    android:id="@+id/hike_track_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hike_route_label"
                            style="@style/Widget.OpenRunner.Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/or_space_xs"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:insetBottom="0dp"
                            android:insetTop="0dp"
                            android:maxLines="2"
                            android:minHeight="48dp"
                            android:paddingHorizontal="0dp"
                            android:visibility="gone"
                            app:icon="@drawable/ic_or_recenter"
                            app:iconGravity="end" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:labelFor="@id/hike_distance"
                                    android:text="@string/hike_distance"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textAppearance="@style/TextAppearance.OpenRunner.Caption" />

                                <TextView
                                    android:id="@+id/hike_distance"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:text="@string/hike_value_missing"
                                    android:textAppearance="@style/TextAppearance.OpenRunner.SectionTitle" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/or_space_sm"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:labelFor="@id/hike_ascent"
                                    android:text="@string/hike_ascent"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textAppearance="@style/TextAppearance.OpenRunner.Caption" />

                                <TextView
                                    android:id="@+id/hike_ascent"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:text="@string/hike_value_missing"
                                    android:textAppearance="@style/TextAppearance.OpenRunner.SectionTitle" />
                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/hike_gps_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/or_space_sm"
                            android:textAppearance="@style/TextAppearance.OpenRunner.Body" />

                        <TextView
                            android:id="@+id/hike_coordinates"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.OpenRunner.Caption"
                            android:textColor="?attr/colorOnSurface"
                            android:textIsSelectable="true"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/hike_legend"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/or_space_xs"
                            android:textAppearance="@style/TextAppearance.OpenRunner.Caption"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hike_attribution"
                            style="@style/Widget.OpenRunner.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingHorizontal="0dp"
                            android:text="@string/hike_sources"
                            android:visibility="gone" />
                    </LinearLayout>
                </cn.edu.pku.openrunner.feature.hike.ui.HikeDetailsScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/or_space_sm"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hike_record"
                        style="@style/Widget.OpenRunner.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/or_space_sm"
                        android:layout_weight="1"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="@dimen/or_space_sm"
                        android:text="@string/hike_start" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hike_history"
                        style="@style/Widget.OpenRunner.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="@dimen/or_space_sm"
                        android:text="@string/hike_history" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ViewStub
        android:id="@+id/hike_files_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/panel_hike_files" />
</FrameLayout>
