<?xml version="1.0" encoding="utf-8"?>
<!--
    data_extraction_rules.xml 的**旧格式孪生兄弟**（API 23–30 用）。

    为什么需要两份：`android:dataExtractionRules` 只被 Android 12（API 31）及以上读取，
    更早的系统看的是 `android:fullBackupContent`。lint 会盯着这件事
    （「since minSdkVersion is API 21 you should also set android:fullBackupContent」），
    官方文档也要求 target 31+ 的应用同时提供两套规则 —— 只写一套，另一半设备上的行为
    就完全由默认值决定，而默认值是「全都备份」。

    本文件与 data_extraction_rules.xml 的排除清单**必须保持一致**。两者格式不同
    （这里是 `<full-backup-content>`，那边分 `<cloud-backup>` / `<device-transfer>` 两段），
    内容却描述同一件事：应用私有目录下的任何东西都不进备份、不随换机迁移。
    理由见 data_extraction_rules.xml 的注释（本应用在 SharedPreferences 里存 access token）。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
