<?xml version="1.0" encoding="utf-8"?>
<!--
    根节点**故意不设** android:background：本页用的是 Activity 的普通主题，而
    Theme.OpenRunner 的 windowBackground 已经是 @color/or_surface，根节点再画一遍
    就是纯多余的一层（lint 的 Overdraw 原先报的就是这里）。窗口背景随深浅模式各自
    解析 or_surface 的变体，所以删掉它不会让底色变化。
    注意 fragment_run / fragment_virtual_location 那两页不一样，它们必须留背景 —— 理由见那边。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/record_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:title="@string/record_detail_title"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/or_on_surface" />

    <View
        style="@style/Widget.OpenRunner.Rule" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/record_detail_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/record_detail_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/or_page_pad"
                android:paddingTop="@dimen/or_page_pad"
                android:paddingEnd="@dimen/or_page_pad"
                android:paddingBottom="@dimen/or_space_xxl">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.OpenRunner.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/or_space_xl">

                        <TextView
                            android:id="@+id/record_detail_source"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/or_space_md"
                            android:letterSpacing="0.1"
                            android:text="@string/record_virtual_test"
                            android:textColor="@color/or_status_virtual"
                            android:textSize="12sp"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/record_detail_label_start"
                            android:textAppearance="@style/TextAppearance.OpenRunner.Label" />

                        <TextView
                            android:id="@+id/record_detail_start"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/or_space_xs"
                            android:textAppearance="@style/TextAppearance.OpenRunner.Body" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/or_space_md"
                            android:text="@string/record_detail_label_end"
                            android:textAppearance="@style/TextAppearance.OpenRunner.Label" />

                        <TextView
                            android:id="@+id/record_detail_end"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/or_space_xs"
                            android:textAppearance="@style/TextAppearance.OpenRunner.Body.Muted" />

                        <View
                            style="@style/Widget.OpenRunner.Rule"
                            android:layout_marginTop="@dimen/or_space_lg" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/or_space_lg"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/record_detail_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.OpenRunner.Display" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/or_space_xs"
                                android:text="@string/record_detail_label_distance"
                                android:textAppearance="@style/TextAppearance.OpenRunner.Label" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/or_space_xl"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/record_detail_duration"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.OpenRunner.Metric.Small" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/or_space_xs"
                                    android:text="@string/record_detail_label_duration"
                                    android:textAppearance="@style/TextAppearance.OpenRunner.Label" />
                            </LinearLayout>

                            <View
                                android:layout_width="@dimen/or_rule_height"
                                android:layout_height="34dp"
                                android:background="@color/or_outline"
                                android:importantForAccessibility="no" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/record_detail_steps"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.OpenRunner.Metric.Small" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/or_space_xs"
                                    android:text="@string/record_detail_label_steps"
                                    android:textAppearance="@style/TextAppearance.OpenRunner.Label" />
                            </LinearLayout>

                            <View
                                android:layout_width="@dimen/or_rule_height"
                                android:layout_height="34dp"
                                android:background="@color/or_outline"
                                android:importantForAccessibility="no" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/record_detail_fastest_pace"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.OpenRunner.Metric.Small" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/or_space_xs"
                                    android:text="@string/record_detail_label_fastest_pace"
                                    android:textAppearance="@style/TextAppearance.OpenRunner.Label" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            style="@style/Widget.OpenRunner.Rule"
                            android:layout_marginTop="@dimen/or_space_lg" />

                        <TextView
                            android:id="@+id/record_detail_samples"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/or_space_md"
                            android:textAppearance="@style/TextAppearance.OpenRunner.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/record_distance_chart_card"
                    style="@style/Widget.OpenRunner.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/or_card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/or_card_pad">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/record_chart_distance_title"
                            android:textAppearance="@style/TextAppearance.OpenRunner.SectionTitle" />

                        <View
                            style="@style/Widget.OpenRunner.Rule.Accent"
                            android:layout_marginTop="@dimen/or_space_sm" />

                        <cn.edu.pku.openrunner.feature.records.ui.RunLineChartView
                            android:id="@+id/record_distance_chart"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:importantForAccessibility="yes" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/record_pace_chart_card"
                    style="@style/Widget.OpenRunner.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/or_card_gap">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/or_card_pad">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/record_chart_pace_title"
                            android:textAppearance="@style/TextAppearance.OpenRunner.SectionTitle" />

                        <View
                            style="@style/Widget.OpenRunner.Rule.Accent"
                            android:layout_marginTop="@dimen/or_space_sm" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/or_space_sm"
                            android:text="@string/record_chart_pace_hint"
                            android:textAppearance="@style/TextAppearance.OpenRunner.Caption" />

                        <cn.edu.pku.openrunner.feature.records.ui.RunLineChartView
                            android:id="@+id/record_pace_chart"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:importantForAccessibility="yes" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/record_route_card"
                    style="@style/Widget.OpenRunner.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/or_card_gap"
                    android:layout_marginBottom="@dimen/or_space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/or_card_pad"
                            android:paddingTop="@dimen/or_card_pad"
                            android:paddingEnd="@dimen/or_card_pad">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/record_route_title"
                                android:textAppearance="@style/TextAppearance.OpenRunner.SectionTitle" />

                            <View
                                style="@style/Widget.OpenRunner.Rule.Accent"
                                android:layout_marginTop="@dimen/or_space_sm" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/record_route_container"
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            android:layout_marginTop="@dimen/or_space_lg"
                            android:background="@color/or_surface_container"
                            android:clipChildren="true"
                            android:clipToPadding="true">

                            <TextView
                                android:id="@+id/record_route_placeholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/or_surface_container"
                                android:gravity="center"
                                android:padding="@dimen/or_space_xl"
                                android:text="@string/record_route_empty"
                                android:textAppearance="@style/TextAppearance.OpenRunner.Caption" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/or_card_pad"
                            android:text="@string/record_route_hint"
                            android:textAppearance="@style/TextAppearance.OpenRunner.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
