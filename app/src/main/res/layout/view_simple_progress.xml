<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@id/v_progress_root" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView android:id="@id/v_progress_img_skyline" android:layout_width="212dp" android:layout_height="88dp" android:layout_gravity="bottom|end" android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY" android:src="@drawable/bg_hero_skyline" />

    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp" android:paddingBottom="18dp">

        <LinearLayout android:orientation="horizontal" android:gravity="bottom" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@id/v_progress_txt_distance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.OpenRunner.HeroValue" />
            <TextView android:id="@id/v_progress_txt_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="5dp" android:textAppearance="@style/TextAppearance.OpenRunner.HeroUnit" />
            <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
            <ImageView android:id="@id/v_progress_img_weather" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center_vertical" android:contentDescription="@null" android:src="@drawable/clip_weather_sun" />
        </LinearLayout>

        <TextView android:id="@id/v_progress_txt_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.OpenRunner.HeroCaption" />

        <LinearLayout android:id="@id/v_progress_progress_group" android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@id/v_progress_progress_distance" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:max="100" app:indicatorColor="@color/or_primary" app:trackColor="@color/or_track" app:trackCornerRadius="4dp" app:trackThickness="8dp" />
            <TextView android:id="@id/v_progress_txt_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textAppearance="@style/TextAppearance.OpenRunner.HeroProgress" />
        </LinearLayout>

        <LinearLayout android:id="@id/v_progress_day_group" android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
            <ImageView android:id="@id/v_progress_img_calendar" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_hero_badge" android:padding="9dp" android:contentDescription="@null" android:src="@drawable/ic_calendar_today" android:tint="@color/or_primary" />
            <TextView android:id="@id/v_progress_txt_day" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textAppearance="@style/TextAppearance.OpenRunner.HeroCaption" />
        </LinearLayout>

        <LinearLayout android:id="@id/v_progress_sleeping_group" android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:visibility="gone">
            <ImageView android:id="@id/v_progress_img_sleeping" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_hero_badge" android:padding="9dp" android:contentDescription="@null" android:src="@drawable/clip_file_not_found" android:tint="@color/or_primary" />
            <TextView android:id="@id/v_progress_txt_sleeping_notice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textAppearance="@style/TextAppearance.OpenRunner.HeroCaption" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
