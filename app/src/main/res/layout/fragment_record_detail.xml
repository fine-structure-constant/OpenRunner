<?xml version="1.0" encoding="utf-8"?>
<!--
    Record detail bottom sheet. Colours come from the or_* semantic tokens so the sheet follows
    light/dark; the sheet surface itself is ?attr/colorSurface (see the MaterialComponents
    BottomSheet style), which @color/or_surface mirrors. That is also what mask_gradient fades
    into, so the photo edge blends in both modes.

    Note: there used to be an ImageView here called f_record_detail_img_padding with
    android:layout_height="0.0dip" plus both top and bottom constraints. In ConstraintLayout
    that means MATCH_CONSTRAINT, not "zero height", so it stretched into a 120dp full-width
    @color/white bar covering the whole stats band. Invisible in light mode (white on white),
    a glaring white block in dark mode. The sheet surface already provides that background, so
    the view is gone.
-->
<androidx.constraintlayout.widget.ConstraintLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView android:id="@id/f_record_detail_img_photo" android:layout_width="match_parent" android:layout_height="200dp" android:background="@color/or_surface_container_high" android:foreground="@drawable/mask_gradient" app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.Guideline android:orientation="vertical" android:id="@id/f_record_detail_guideline_vertical_mid" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintGuide_percent="0.5" />
    <ImageView android:id="@id/f_record_detail_circle_bg" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="16dp" android:layout_marginBottom="16dp" android:src="@drawable/circle_bg" app:layout_constraintBottom_toTopOf="@id/f_record_detail_guideline_detail_top" app:layout_constraintStart_toStartOf="parent" />
    <TextView android:id="@id/f_record_detail_txt_place" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="center" android:textAppearance="@style/TextAppearance.OpenRunner.ItemAvatar" app:layout_constraintBottom_toBottomOf="@id/f_record_detail_circle_bg" app:layout_constraintLeft_toLeftOf="@id/f_record_detail_circle_bg" app:layout_constraintTop_toTopOf="@id/f_record_detail_circle_bg" />
    <TextView android:id="@id/f_record_detail_txt_distance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:textAppearance="@style/TextAppearance.OpenRunner.SectionTitle" app:layout_constraintStart_toEndOf="@id/f_record_detail_circle_bg" app:layout_constraintTop_toTopOf="@id/f_record_detail_circle_bg" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:text="@string/v_record_km" android:textAppearance="@style/TextAppearance.OpenRunner.ItemUnit" app:layout_constraintBaseline_toBaselineOf="@id/f_record_detail_txt_distance" app:layout_constraintStart_toEndOf="@id/f_record_detail_txt_distance" />
    <TextView android:id="@id/f_record_detail_txt_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:textAlignment="textEnd" android:textAppearance="@style/TextAppearance.OpenRunner.ItemMeta" app:layout_constraintBaseline_toBaselineOf="@id/f_record_detail_txt_distance" app:layout_constraintEnd_toEndOf="parent" />
    <TextView android:id="@id/f_record_detail_txt_uid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginEnd="10dp" android:alpha="0.7" android:textAlignment="textEnd" android:textAppearance="@style/TextAppearance.OpenRunner.ItemMeta" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@id/f_record_detail_txt_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textAppearance="@style/TextAppearance.OpenRunner.ItemSubtitle" android:textColor="@color/or_primary" app:layout_constraintStart_toStartOf="@id/f_record_detail_txt_distance" app:layout_constraintTop_toBottomOf="@id/f_record_detail_txt_distance" />
    <androidx.constraintlayout.widget.Guideline android:orientation="horizontal" android:id="@id/f_record_detail_guideline_detail_top" android:padding="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintGuide_begin="200dp" />
    <ImageView android:id="@id/f_record_detail_img_lap" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:src="@drawable/ic_all_inclusive_black_24dp" app:tint="@color/or_on_surface_variant" app:layout_constraintBottom_toTopOf="@id/f_record_detail_guideline_detail_mid" app:layout_constraintLeft_toLeftOf="parent" app:layout_constraintTop_toBottomOf="@id/f_record_detail_guideline_detail_top" />
    <TextView android:id="@id/f_record_detail_txt_laps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:textAppearance="@style/TextAppearance.OpenRunner.ItemSubtitle" android:textColor="@color/or_on_surface_variant" app:layout_constraintBottom_toTopOf="@id/f_record_detail_guideline_detail_mid" app:layout_constraintStart_toEndOf="@id/f_record_detail_img_lap" app:layout_constraintTop_toBottomOf="@id/f_record_detail_guideline_detail_top" />
    <ImageView android:id="@id/f_record_record_img_location" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:src="@drawable/ic_pin_drop_black_24dp" app:tint="@color/or_on_surface_variant" app:layout_constraintBottom_toTopOf="@id/f_record_detail_guideline_detail_mid" app:layout_constraintLeft_toLeftOf="@id/f_record_detail_guideline_vertical_mid" app:layout_constraintTop_toBottomOf="@id/f_record_detail_guideline_detail_top" />
    <TextView android:id="@id/f_record_detail_txt_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:textAppearance="@style/TextAppearance.OpenRunner.ItemSubtitle" android:textColor="@color/or_on_surface_variant" app:layout_constraintBottom_toTopOf="@id/f_record_detail_guideline_detail_mid" app:layout_constraintStart_toEndOf="@id/f_record_record_img_location" app:layout_constraintTop_toBottomOf="@id/f_record_detail_guideline_detail_top" />
    <androidx.constraintlayout.widget.Guideline android:orientation="horizontal" android:id="@id/f_record_detail_guideline_detail_mid" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintGuide_begin="256dp" />
    <ImageView android:id="@id/f_record_detail_img_step" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:src="@drawable/ic_directions_walk_black_24dp" app:tint="@color/or_on_surface_variant" app:layout_constraintBottom_toTopOf="@id/f_record_detail_guideline_detail_bottom" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/f_record_detail_guideline_detail_mid" />
    <TextView android:id="@id/f_record_detail_txt_steps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:textAppearance="@style/TextAppearance.OpenRunner.ItemSubtitle" android:textColor="@color/or_on_surface_variant" app:layout_constraintBottom_toTopOf="@id/f_record_detail_guideline_detail_bottom" app:layout_constraintStart_toEndOf="@id/f_record_detail_img_step" app:layout_constraintTop_toBottomOf="@id/f_record_detail_guideline_detail_mid" />
    <ImageView android:id="@id/f_record_detail_img_speed" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp" android:src="@drawable/ic_near_me_black_24dp" app:tint="@color/or_on_surface_variant" app:layout_constraintBottom_toTopOf="@id/f_record_detail_guideline_detail_bottom" app:layout_constraintStart_toStartOf="@id/f_record_detail_guideline_vertical_mid" app:layout_constraintTop_toBottomOf="@id/f_record_detail_guideline_detail_mid" />
    <TextView android:id="@id/f_record_detail_txt_speed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:textAppearance="@style/TextAppearance.OpenRunner.ItemSubtitle" android:textColor="@color/or_on_surface_variant" app:layout_constraintBottom_toTopOf="@id/f_record_detail_guideline_detail_bottom" app:layout_constraintStart_toEndOf="@id/f_record_detail_img_speed" app:layout_constraintTop_toBottomOf="@id/f_record_detail_guideline_detail_mid" />
    <androidx.constraintlayout.widget.Guideline android:orientation="horizontal" android:id="@id/f_record_detail_guideline_detail_bottom" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintGuide_begin="312dp" />
    <androidx.constraintlayout.widget.Guideline android:orientation="horizontal" android:id="@id/f_record_detail_guideline_above_map" android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintGuide_begin="320dp" />
    <com.amap.api.maps2d.MapView android:id="@id/f_record_detail_map" android:layout_width="match_parent" android:layout_height="480dp" android:elevation="-2dp" app:layout_constraintTop_toTopOf="@id/f_record_detail_guideline_above_map" />
</androidx.constraintlayout.widget.ConstraintLayout>
