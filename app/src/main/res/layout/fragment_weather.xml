<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/or_page_pad"
        android:paddingTop="@dimen/or_page_pad"
        android:paddingEnd="@dimen/or_page_pad"
        android:paddingBottom="@dimen/or_space_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Widget.OpenRunner.Seal"
                android:text="@string/or_seal_weather" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/weather_title"
                android:textAppearance="@style/TextAppearance.OpenRunner.PageTitle" />
        </LinearLayout>

        <View
            android:layout_width="26dp"
            android:layout_height="@dimen/or_rule_height_strong"
            android:layout_marginTop="@dimen/or_space_md"
            android:background="@color/or_primary"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/weather_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/or_space_lg"
            android:text="@string/weather_loading"
            android:textAppearance="@style/TextAppearance.OpenRunner.Body.Muted" />

        <TextView
            android:id="@+id/weather_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/or_space_lg"
            android:textAppearance="@style/TextAppearance.OpenRunner.Body"
            android:textColor="@color/or_accent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/weather_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.OpenRunner.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/or_space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/or_space_xl">

                    <TextView
                        android:id="@+id/weather_city"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:textColor="?attr/orOnHeroSurface"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="26dp"
                        android:layout_height="@dimen/or_rule_height_strong"
                        android:layout_marginTop="@dimen/or_space_md"
                        android:alpha="0.55"
                        android:background="?attr/orOnHeroSurface"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/weather_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/or_space_md"
                        android:textAppearance="@style/TextAppearance.OpenRunner.Metric"
                        android:textColor="?attr/orOnHeroSurface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.OpenRunner.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/or_card_gap">

                <TextView
                    android:id="@+id/weather_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/or_card_pad"
                    android:textAppearance="@style/TextAppearance.OpenRunner.Body" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/or_space_xxl"
                android:text="@string/weather_forecast_title"
                android:textAppearance="@style/TextAppearance.OpenRunner.SectionTitle" />

            <View
                android:layout_width="26dp"
                android:layout_height="@dimen/or_rule_height_strong"
                android:layout_marginTop="@dimen/or_space_sm"
                android:background="@color/or_primary"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/weather_forecasts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/or_space_sm"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/weather_refresh"
                style="@style/Widget.OpenRunner.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/or_space_xl"
                android:text="@string/weather_refresh" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
