<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/or_page_pad"
        android:paddingTop="@dimen/or_page_pad"
        android:paddingEnd="@dimen/or_page_pad">

        <TextView
            style="@style/Widget.OpenRunner.Seal"
            android:text="@string/or_seal_tasks" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/nav_tasks"
            android:textAppearance="@style/TextAppearance.OpenRunner.PageTitle" />
    </LinearLayout>

    <View
        android:layout_width="26dp"
        android:layout_height="@dimen/or_rule_height_strong"
        android:layout_marginStart="@dimen/or_page_pad"
        android:layout_marginTop="@dimen/or_space_md"
        android:background="@color/or_primary"
        android:importantForAccessibility="no" />

    <!--
        固定头部与可滚动列表的分界线。
        下面的 RecyclerView 独立滚动，clipToPadding=false 让它能画进自己的 padding 里，
        于是列表项贴着这条线上沿被裁掉；没有线的话内容像是「凭空出现」，边界读不出来。
        用通栏细分隔线而非缩进，让它读作结构分界而不是标题的一部分。
        与标题下那根 26dp 品牌色短横留出 or_space_lg 的间距 —— 短横是分区标记（属于标题），
        这条是版面分界，两者贴太近会被读成一对装饰。
    -->
    <View
        style="@style/Widget.OpenRunner.Rule"
        android:layout_marginTop="@dimen/or_space_lg" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/tasks_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tasks_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/or_page_pad"
                android:paddingTop="@dimen/or_space_sm"
                android:paddingEnd="@dimen/or_page_pad"
                android:paddingBottom="@dimen/or_page_pad" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/tasks_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tasks_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/tasks_empty"
            android:textAppearance="@style/TextAppearance.OpenRunner.Body.Muted"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
